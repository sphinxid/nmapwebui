{
  "name": "nmapwebui-frontend",
  "private": true,
  "description": "Frontend asset build for NmapWebUI (Tailwind CSS + vendored libraries)",
  "scripts": {
    "build:css": "tailwindcss -i static/css/input.css -o static/css/app.css --minify",
    "watch:css": "tailwindcss -i static/css/input.css -o static/css/app.css --watch",
    "vendor": "node scripts/vendor.js",
    "build": "npm run vendor && npm run build:css"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.5.2",
    "chart.js": "^4.4.3",
    "tailwindcss": "^3.4.10"
  }
}
